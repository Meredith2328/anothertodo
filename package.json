{
  "name": "anothertodo",
  "version": "0.2.0",
  "private": false,
  "main": "dist-node/cli.js",
  "files": [
    "dist-node/**",
    "bin/atd.mjs",
    "docs/node-usage.md",
    "docs/platform-acceptance.md",
    "docs/ts-migration-plan.md",
    "README.md"
  ],
  "bin": {
    "atd": "bin/atd.mjs"
  },
  "description": "anothertodo TypeScript/Node.js CLI, TUI, reminders, and Git sync",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --platform node --out-dir dist-node --clean",
    "build:sea": "node tools/build-sea.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke": "node tools/smoke-node.mjs",
    "test:tui:stable": "node tools/test-tui-stability.mjs 20"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@napi-rs/canvas": "^1.0.7",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.12",
    "eslint": "^9.17.0",
    "ink-testing-library": "^4.0.0",
    "postject": "1.0.0-alpha.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@iarna/toml": "^3.0.0",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "ink": "^5.1.0",
    "nodemailer": "^6.9.16",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "zod": "^3.24.1"
  }
}
